# Environment Configuration for travel-knowledge-mcp-server

# Server Settings
HOST=0.0.0.0
PORT=8000

# Enterprise RAG Strategy Selection
VECTOR_STORE=chroma
RETRIEVAL_STRATEGY=vector_similarity
QUERY_STRATEGY=default
RERANKING_STRATEGY=no_op
EMBEDDING_PROVIDER=sentence-transformers

# Model Parameters
EMBEDDING_MODEL=all-MiniLM-L6-v2
TOP_K=5

# Vector Store Connection Details
CHROMA_COLLECTION=travel_knowledge
CHROMA_PERSIST_DIRECTORY=../travel-knowledge-ingestion/chroma
